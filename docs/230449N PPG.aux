\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}PI Controller}{8}{subsection.3.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces LTspice schematic of the PI controller. The P-controller (U11) uses R15 = R16 = 1\,M$\Omega $ input resistors, R17 = 1\,M$\Omega $ and R18 = 470\,k$\Omega $ feedback. The I-controller (U12) uses R19 = 1\,M$\Omega $ input and C5 = 470\,nF feedback capacitor. R20 = 1\,M$\Omega $ provides a DC bias path.}}{8}{figure.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.7}Final Circuit Diagram}{8}{subsection.3.7}\protected@file@percent }
