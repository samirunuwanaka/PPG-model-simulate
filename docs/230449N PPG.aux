\@writefile{toc}{\contentsline {section}{\numberline {4}Observations}{9}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Emitter Stage Waveform}{9}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Emitter stage waveforms: V(n031) shows the MOSFET gate voltage (green, left axis, 1.80--2.35\,V), and I(D1) shows the LED current (red, right axis, 9--42\,mA). The LED is on for 500\,ms and off for 500\,ms.}}{9}{figure.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Transimpedance Amplifier Output (Current Adder)}{9}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Output waveform V(n018) of the current adder / TIA stage. The signal ranges from approximately 24\,mV to 104\,mV, with an initial transient settling within 0.2\,s. The 100\,Hz noise component is clearly visible.}}{10}{figure.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Non-Inverting Amplifier Output}{10}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Output waveform V(n014) of the non-inverting amplifier stage. The signal oscillates between approximately 2.40\,V and 2.60\,V, centred around the 2.5\,V bias. The waveform settles after the initial transient.}}{11}{figure.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Receiver Integrator / Filter Output}{11}{subsection.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Output waveform V(n019) of the receiver integrator stage. The signal ranges from approximately $-15$\,mV to 45\,mV. The initial transient settles by approximately 0.2\,s.}}{12}{figure.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Integrated Emitter with Sensor Output}{13}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Output waveform V(n034) of the integrated emitter--sensor circuit. The signal oscillates between approximately $-15$\,mV and $+15$\,mV. The 100\,Hz noise component remains visible, with the pulsatile envelope modulating the amplitude.}}{13}{figure.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}PPG Sensor with PI Controller Output}{13}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Final PPG output waveform V(n013) with PI controller. The signal ranges from approximately 2.43\,V to 2.53\,V, centred around 2.50\,V. The cardiac pulse waveform with a period of approximately 10\,ms is clearly visible after the initial settling transient.}}{13}{figure.15}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7}PI Controller Feedback Signals}{13}{subsection.4.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces PI controller feedback output V(n001). The signal is nearly constant at approximately 5.0702\,V, indicating the integrator has settled.}}{14}{figure.16}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces PI controller feedback input V(n043). The signal oscillates around 1.2899\,V with a small AC component (approximately $\pm 10\,\mu $V at steady state), confirming that the PI controller is correctly tracking the reference.}}{14}{figure.17}\protected@file@percent }
